    {
      "id": "macos-defaults",
      "name": "macOS Settings",
      "description": "Dock auto-hide and size, Finder list view, Dark mode, tap to click, three-finger drag",
      "category": "system",
      "icon": "gearshape",
      "icon_color": "gray",
      "depends_on": [],
      "install": { "method": "defaults" },
      "defaults": [
        { "domain": "com.apple.dock", "key": "autohide", "type": "bool", "value": true },
        { "domain": "com.apple.dock", "key": "tilesize", "type": "float", "value": 43 },
        { "domain": "com.apple.dock", "key": "magnification", "type": "bool", "value": true },
        { "domain": "com.apple.dock", "key": "largesize", "type": "float", "value": 52 },
        { "domain": "com.apple.finder", "key": "FXPreferredViewStyle", "type": "string", "value": "Nlsv" },
        { "domain": "NSGlobalDomain", "key": "AppleInterfaceStyle", "type": "string", "value": "Dark" },
        { "domain": "com.apple.AppleMultitouchTrackpad", "key": "Clicking", "type": "bool", "value": true },
        { "domain": "com.apple.driver.AppleBluetoothMultitouch.trackpad", "key": "Clicking", "type": "bool", "value": true },
        { "domain": "NSGlobalDomain", "key": "com.apple.mouse.tapBehavior", "type": "int", "value": 1, "current_host": true },
        { "domain": "com.apple.AppleMultitouchTrackpad", "key": "TrackpadThreeFingerDrag", "type": "bool", "value": true },
        { "domain": "com.apple.driver.AppleBluetoothMultitouch.trackpad", "key": "TrackpadThreeFingerDrag", "type": "bool", "value": true },
        { "domain": "com.apple.WindowManager", "key": "EnableTiledWindowMargins", "type": "bool", "value": false }
      ],
      "restart": ["Dock", "Finder"],
      "post_install": "Log out and back in so the trackpad settings take effect."
