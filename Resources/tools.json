      "icon": "gearshape",
      "icon_color": "gray",
      "depends_on": [],
      "install": { "method": "defaults" },
      "defaults": [
        { "domain": "com.apple.dock", "key": "autohide", "type": "bool", "value": true },
        { "domain": "com.apple.dock", "key": "tilesize", "type": "float", "value": 43 },
        { "domain": "com.apple.dock", "key": "magnification", "type": "bool", "value": true },
        { "domain": "com.apple.dock", "key": "largesize", "type": "float", "value": 52 },
        { "domain": "com.apple.finder", "key": "FXPreferredViewStyle", "type": "string", "value": "Nlsv" },
