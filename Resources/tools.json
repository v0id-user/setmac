  "tools": [
    {
      "id": "xcode-clt",
      "name": "Xcode Command Line Tools",
      "description": "Apple's developer tools (compilers, git, make)",
      "category": "essentials",
      "icon": "hammer",
      "icon_color": "blue",
      "depends_on": [],
      "check": {
        "command": "xcode-select -p >/dev/null 2>&1 && test -x \"$(xcode-select -p)/usr/bin/git\"",
        "version_command": "pkgutil --pkg-info=com.apple.pkg.CLTools_Executables 2>/dev/null | sed -n 's/^version: //p'"
      },
      "install": {
        "method": "script",
        "script": "set -e\nif xcode-select -p >/dev/null 2>&1; then exit 0; fi\n# Ask softwareupdate for the CLT package directly, which avoids the GUI dialog.\nmarker=/tmp/.com.apple.dt.CommandLineTools.installondemand.in-progress\ntouch \"$marker\"\nlabel=$(softwareupdate -l 2>/dev/null | sed -n 's/^.*\\* Label: \\(Command Line Tools.*\\)$/\\1/p' | sort -V | tail -1)\nif [ -n \"$label\" ]; then\n  echo \"Installing $label\"\n  sudo -A softwareupdate -i \"$label\" --verbose\n  rm -f \"$marker\"\nelse\n  rm -f \"$marker\"\n  echo \"softwareupdate has no CLT package; opening Apple's installer. Click Install in the dialog.\"\n  xcode-select --install || true\n  waited=0\n  until xcode-select -p >/dev/null 2>&1; do\n    sleep 10; waited=$((waited + 10))\n    [ \"$waited\" -lt 3600 ] || { echo \"Gave up waiting for Command Line Tools\"; exit 1; }\n  done\nfi\nxcode-select -p",
        "requires_admin": true
      }
    },
    {
      "id": "rosetta",
      "name": "Rosetta 2",
      "description": "Runs Intel-only apps and binaries on Apple Silicon",
      "category": "essentials",
      "icon": "cpu",
      "icon_color": "gray",
      "depends_on": [],
      "check": {
        "command": "[ \"$(uname -m)\" != arm64 ] || /usr/bin/pgrep -q oahd || [ -e /Library/Apple/usr/share/rosetta/rosetta ]"
      },
      "install": {
        "method": "script",
        "script": "sudo -A softwareupdate --install-rosetta --agree-to-license",
        "requires_admin": true
      }
    },
