        "method": "custom",
        "script": "work=$(mktemp -d) && curl -fsSL -o \"$work/Pier.dmg\" https://github.com/neethanwu/pier/releases/latest/download/Pier.dmg && hdiutil attach -nobrowse -quiet -mountpoint \"$work/mnt\" \"$work/Pier.dmg\" && ditto \"$work/mnt/Pier.app\" /Applications/Pier.app; status=$?; hdiutil detach -quiet \"$work/mnt\" 2>/dev/null; rm -rf \"$work\"; exit $status"
